# Broker mode: robinhood (default) | tastytrade
BROKER=robinhood

# Robinhood: no official stock REST API — HUD prints a manual order ticket.
# Size these to YOUR account (defaults below are conservative vs the original $150k IRA clip).
RH_ACCOUNT_ID=robinhood
TARGET_CLIP_USD=5000
MAX_NOTIONAL_USD=5500
MAX_SHARE_COUNT=500
MAX_RISK_USD=150

# ---------------------------------------------------------------------------
# Tastytrade only (optional) — set BROKER=tastytrade and fill these in
# ---------------------------------------------------------------------------
# TT_USERNAME=your_tastytrade_username_or_email
# TT_PASSWORD=your_tastytrade_password
# TT_ACCOUNT_ID=5WJ26897
# TT_PROVIDER_SECRET=your_oauth_client_secret
# TT_REFRESH_TOKEN=your_oauth_refresh_token
# TT_SANDBOX=false
